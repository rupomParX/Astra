# URL where clients reach your homeserver (not necessarily the Element URL)
HOMESERVER_URL=https://private.animebd.xyz/

# Only used by `npm run login` (one-time). You can delete these afterwards.
BOT_USERNAME=
BOT_PASSWORD=

# Paste the token printed by `npm run login`
ACCESS_TOKEN=

# Command prefix
PREFIX=!

# Comma-separated Matrix IDs allowed to run admin commands (e.g. !say)
ADMINS=

# Where the bot keeps its sync state
STORAGE_FILE=data/bot.json
